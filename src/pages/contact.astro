---
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/contact.scss';

interface SocialLink {
  name: string;
  icon: string;
  url: string;
  username: string;
  color: string;
}

const profile = {
  name: 'Jeremy Yazid Anton Rojas',
  role: 'Full Stack Developer & SEO',
  status: 'open_for_projects',
  preferred_contact: 'email',
  response_time: '24-48h',
  languages: ['Spanish'],
  timezone: 'UTC-5 (Lima)',
  availability: 'Freelance • Remote',
};

const socialLinks: SocialLink[] = [
  {
    name: 'GitHub',
    icon: 'devicon-github-original',
    url: 'https://github.com/jere792',
    username: '@jere792',
    color: '#ffffff',
  },
  {
    name: 'LinkedIn',
    icon: 'devicon-linkedin-plain',
    url: 'https://www.linkedin.com/in/jeremy-ant%C3%B3n-61980235b/',
    username: 'Jeremy Anton',
    color: '#0077b5',
  },
  {
    name: 'Email',
    icon: 'pi pi-envelope',
    url: 'mailto:jeremyar792@gmail.com',
    username: 'jeremyar792@gmail.com',
    color: '#ea4335',
  },
  {
    name: 'WhatsApp',
    icon: 'pi pi-whatsapp',
    url: 'https://wa.me/51907851879',
    username: '+51 907 851 879',
    color: '#25d366',
  },
];

const services = [
  'Desarrollo de aplicaciones web full-stack',
  'SEO técnico y optimización de rendimiento web',
  'Arquitectura de sistemas escalables',
  'Integración de APIs REST y GraphQL',
  'Consultoría técnica en React, Next.js y NestJS',
  'Optimización de bases de datos',
];

const profileJson = `{
  "role": "${profile.role}",
  "status": "${profile.status}",
  "availability": "${profile.availability}",
  "preferred_contact": "${profile.preferred_contact}",
  "response_time": "${profile.response_time}",
  "timezone": "${profile.timezone}",
  "languages": [${profile.languages.map((language) => `"${language}"`).join(', ')}]
}`;
---

<Layout
  title="Contacto | Jeremy Anton"
  description="Contacta a Jeremy Anton por email, GitHub, LinkedIn o WhatsApp para proyectos freelance y colaboraciones."
>
  <div class="contact-container">
    <div class="code-editor">
      <div class="line-numbers">
        {Array.from({ length: 40 }, (_, i) => <span>{i + 1}</span>)}
      </div>

      <div class="code-content">
        <header class="contact-header">
          <h1 class="page-title"># Contacto</h1>
          <p class="page-subtitle">// Let&apos;s connect and create innovative solutions</p>
        </header>

        <section class="contact-section">
          <div class="contact-grid">
            <div class="terminal-card">
              <div class="terminal-header">
                <span class="terminal-button red"></span>
                <span class="terminal-button yellow"></span>
                <span class="terminal-button green"></span>
                <span class="terminal-title">contact.ts</span>
              </div>

              <div class="terminal-content">
                <div class="terminal-block">
                  <p class="terminal-line">
                    <span class="terminal-user">jeremy@portfolio:</span>
                    <span class="terminal-path">~/contact$</span>
                    <span class="terminal-command"> whoami</span>
                  </p>
                  <div class="terminal-output">
                    <p class="output-name">{profile.name}</p>
                    <p class="output-role">{profile.role}</p>
                  </div>
                </div>

                <div class="terminal-block">
                  <p class="terminal-line">
                    <span class="terminal-user">jeremy@portfolio:</span>
                    <span class="terminal-path">~/contact$</span>
                    <span class="terminal-command"> cat profile.json</span>
                  </p>
                  <div class="terminal-output json-output">
                    <pre>{profileJson}</pre>
                  </div>
                </div>

                <div class="terminal-block">
                  <p class="terminal-line">
                    <span class="terminal-user">jeremy@portfolio:</span>
                    <span class="terminal-path">~/contact$</span>
                    <span class="terminal-command"> cat services.txt</span>
                  </p>
                  <div class="terminal-output">
                    <ul class="services-list">
                      {services.map((service) => <li>{service}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <div class="social-wrapper">
              <div class="social-card">
                <h2 class="social-title">
                  <i class="pi pi-share-alt"></i>
                  # Canales de Comunicación
                </h2>

                <div class="social-links">
                  {
                    socialLinks.map((social) => (
                      <a
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="social-link"
                      >
                        <i class={social.icon} style={`color: ${social.color}`}></i>
                        <div class="social-info">
                          <span class="social-name">{social.name}</span>
                          <span class="social-username">{social.username}</span>
                        </div>
                      </a>
                    ))
                  }
                </div>

                <div class="contact-note">
                  <i class="pi pi-info-circle"></i>
                  <p>
                    <strong>Horario de respuesta:</strong> {profile.response_time}<br />
                    Para colaboraciones profesionales o consultas técnicas, el contacto preferido es
                    por <strong>{profile.preferred_contact}</strong>.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="status-bar">
      <div class="status-left">
        <span><i class="pi pi-check-circle"></i> TypeScript</span>
        <span><i class="pi pi-code"></i> UTF-8</span>
      </div>
      <div class="status-right">
        <span>Ln 35, Col 22</span>
      </div>
    </div>
  </div>
</Layout>
