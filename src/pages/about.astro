---
import Layout from '@/layouts/Layout.astro';
import GithubActivity from '@/components/shared/GithubActivity.astro';
import '@/styles/pages/about.scss';

const image =
  'https://res.cloudinary.com/dpnxbnqxu/image/upload/v1773368005/foto-git_viukel.jpg';

const skills = {
  backend: [
    'Node.js',
    'Express',
    'TypeScript',
    'GraphQL',
    'REST APIs',
    'ASP.NET Core',
    'Spring Boot',
    'C#',
    'Java',
  ],
  frontend: ['React', 'TypeScript', 'JavaScript', 'SCSS', 'HTML5', 'CSS3'],
  database: ['SQL Server', 'MySQL', 'MongoDB', 'Stored Procedures'],
  tools: ['Git/GitHub', 'Cloudinary', 'JWT Auth', 'Vercel'],
};
---

<Layout
  title="Sobre mí | Jeremy Anton"
  description="Conoce a Jeremy Anton: estudiante de Ingeniería de Sistemas, desarrollador frontend con React, TypeScript y Astro, y experiencia full-stack."
>
  <div class="about-container">
    <div class="code-editor">
      <div class="line-numbers">
        {Array.from({ length: 60 }, (_, i) => <span>{i + 1}</span>)}
      </div>

      <div class="code-content">
        <h1 class="page-title"># Sobre Mí</h1>

        <div class="main-layout">
          <div class="left-column">
            <p class="code-comment">// Personal Information</p>

            <div class="profile-card">
              <div class="avatar">
                <img src={image} alt="Jeremy Anton" width="200" height="200" loading="lazy" />
              </div>

              <div class="status-badge">
                <span class="status-dot"></span>
                Disponible para oportunidades
              </div>

              <div class="info-list">
                <div class="info-item">
                  <span class="info-key">name:</span>
                  <span class="info-value">&quot;Jeremy Anton&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">role:</span>
                  <span class="info-value">&quot;Systems Engineer&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">location:</span>
                  <span class="info-value">&quot;Lima, Peru&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">experience:</span>
                  <span class="info-value">8+ months</span>
                </div>
                <div class="info-item">
                  <span class="info-key">university:</span>
                  <span class="info-value">&quot;UPN&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">degree:</span>
                  <span class="info-value">&quot;Ing. de Sistemas&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">semester:</span>
                  <span class="info-value">&quot;8vo ciclo&quot;</span>
                </div>
                <div class="info-item">
                  <span class="info-key">focus:</span>
                  <span class="info-value">&quot;Frontend Development&quot;</span>
                </div>
              </div>
            </div>
          </div>

          <div class="right-column">
            <div class="section">
              <p class="code-comment">// About Me</p>
              <div class="about-text">
                <p>
                  Soy <strong class="name">Jeremy Yazid Anton Rojas</strong>, estudiante de octavo
                  ciclo de Ingeniería de Sistemas Computacionales en la
                  <strong class="university"> Universidad Privada del Norte</strong>, enfocado en el
                  desarrollo de aplicaciones web modernas y administración de sistemas.
                </p>
                <p>
                  Me especializo en desarrollo
                  <strong class="tech"> frontend con React y TypeScript</strong>, creando interfaces
                  modernas y responsivas con <strong class="tech">Astro y SCSS</strong>. Complemento
                  mi perfil con conocimientos de
                  <strong class="tech"> backend (Node.js, Express)</strong>, bases de datos
                  <strong class="tech"> (SQL Server, MySQL, MongoDB)</strong>, lo que me permite
                  desarrollar soluciones completas de extremo a extremo.
                </p>
              </div>
            </div>

            <div class="section">
              <p class="code-comment">// Stack Tecnológico</p>
              <div class="tech-stack">
                {
                  Object.entries(skills).map(([category, techs]) => (
                    <div class="tech-category">
                      <h3>{category}</h3>
                      <div class="tech-tags">
                        {techs.map((tech) => (
                          <span class="tech-tag">{tech}</span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="section">
              <div class="bottom-grid">
                <div class="bottom-item">
                  <p class="code-comment">// Contact</p>
                  <div class="contact-card">
                    <div class="contact-item">
                      <i class="pi pi-envelope"></i>
                      <a href="mailto:jeremyar792@gmail.com">jeremyar792@gmail.com</a>
                    </div>
                    <div class="contact-item">
                      <i class="pi pi-phone"></i>
                      <a href="tel:+51907851879">+51 907 851 879</a>
                    </div>
                  </div>
                </div>

                <div class="bottom-item">
                  <p class="code-comment">// GitHub Stats</p>
                  <div class="stats-card">
                    <div class="stat-item">
                      <span class="stat-number" data-github-stat="public_repos">...</span>
                      <span class="stat-label">Repos</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                      <span class="stat-number" data-github-stat="followers">...</span>
                      <span class="stat-label">Followers</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                      <span class="stat-number" data-github-stat="following">...</span>
                      <span class="stat-label">Following</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="contrib-wrapper">
                <div class="contrib-inner">
                  <p class="code-comment" style="margin-top: 0">// GitHub Activity</p>
                  <GithubActivity compact />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="status-bar">
      <div class="status-left">
        <span><i class="pi pi-check-circle"></i> TypeScript</span>
        <span><i class="pi pi-code"></i> UTF-8</span>
      </div>
      <div class="status-right">
        <span>Ln 60, Col 18</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  fetch('https://api.github.com/users/jere792')
    .then((res) => res.json())
    .then((data) => {
      document.querySelectorAll('[data-github-stat]').forEach((el) => {
        const key = el.getAttribute('data-github-stat');
        if (key && data[key] != null) el.textContent = String(data[key]);
      });
    })
    .catch(() => {});
</script>
