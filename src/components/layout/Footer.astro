---
import './Footer.scss';

const currentYear = new Date().getFullYear();

const userInfo = {
  name: 'Jeremy Anton',
  email: 'jeremyar792@gmail.com',
  role: 'Full Stack Developer & SEO',
};

const navigationCommands = [
  { command: 'git checkout', page: 'about' },
  { command: 'git checkout', page: 'projects' },
  { command: 'git checkout', page: 'experience' },
  { command: 'git checkout', page: 'contact' },
];

const modifiedFiles = [
  '/layouts/Layout.astro',
  '/pages/about.astro',
  '/pages/projects.astro',
  '/styles/globals.scss',
];

const siteInfo = {
  version: '1.0.0',
  lastUpdated: 'January 2026',
  framework: 'Astro',
  language: 'TypeScript',
};
---

<footer class="footer-container">
  <div class="terminal">
    <div class="terminal-header">
      <div class="terminal-controls">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <span class="terminal-title">jeremy&#64;portfolio:~</span>
      <span class="terminal-badge">bash</span>
    </div>

    <div class="terminal-body">
      <div class="footer-grid">
        <div class="left-column">
          <div class="command-block">
            <p class="command-line">
              <span class="command">git status</span>
            </p>
          </div>

          <div class="git-output">
            <p class="output-comment">
              # Please enter the commit message for your changes. Lines starting
            </p>
            <p class="output-comment"># On branch <span class="highlight-red">main</span></p>
            <p class="output-comment">
              # Your branch is up to date with <span class="highlight-green">&apos;origin/main&apos;</span>.
            </p>
            <p class="output-comment">#</p>
            <p class="output-info"># Changes to be committed:</p>
            <p class="output-comment"># (use &quot;git reset HEAD &lt;file&gt;...&quot; to unstage)</p>
            <p class="output-comment">#</p>
            {
              modifiedFiles.map((file) => (
                <p class="output-modified">
                  # <span class="modified-label">modified:</span> {file}
                </p>
              ))
            }
          </div>

          <div class="command-input">
            <p class="prompt-line">
              ~ git commit -m &quot;feat(ui): implement portfolio footer&quot;<span class="cursor"
                >&#9608;</span
              >
            </p>
          </div>
        </div>

        <div class="right-column">
          <div class="command-block">
            <p class="section-title">.GIT/CONFIG [USER]</p>
            <p class="config-line"><span class="config-key">name</span> = {userInfo.name}</p>
            <p class="config-line"><span class="config-key">email</span> = {userInfo.email}</p>
            <p class="config-line"><span class="config-key">role</span> = {userInfo.role}</p>
          </div>

          <div class="command-block">
            <p class="section-title">.GIT/CONFIG [NAVIGATION]</p>
            {
              navigationCommands.map((cmd) => (
                <p class="config-line">
                  <span class="highlight-cyan">{cmd.command}</span> {cmd.page}
                </p>
              ))
            }
          </div>

          <div class="terminal-footer">
            <p>~ &copy; {currentYear} {userInfo.name}.</p>
            <p>All systems operational.</p>
            <p>Built with {siteInfo.framework}, {siteInfo.language} &amp; SCSS.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="terminal-status-bar">
      <div class="status-left">
        <span class="status-mode insert">INSERT</span>
        <span class="status-branch">MAIN</span>
      </div>
      <div class="status-right">
        <span>UTF-8 | UNIX | {siteInfo.framework} + {siteInfo.language}</span>
      </div>
    </div>
  </div>
</footer>
