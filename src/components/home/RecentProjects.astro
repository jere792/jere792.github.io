---
import { PROJECT_SECTIONS } from '@/data/projects';
import './RecentProjects.scss';

const recentProjects = PROJECT_SECTIONS.flatMap((section) => section.projects)
  .filter((project) => project.images.length > 0)
  .slice(0, 2);
const colors = ['#58a6ff', '#7ee787'];
const getCategoryColor = (index: number) => colors[index] ?? '#58a6ff';
---

<section class="recent-section">
  <div class="section-header">
    <div class="header-left">
      <span class="eyebrow">
        <i class="pi pi-code"></i>
        En desarrollo
      </span>
      <h2 class="section-title">Proyectos Recientes</h2>
    </div>
    <a class="btn-more" href="/projects/">
      <span>Ver todos</span>
      <i class="pi pi-arrow-right"></i>
    </a>
  </div>

  <div class="projects-grid">
    {
      recentProjects.map((project, index) => (
        <a
          class="project-card"
          href={`/projects/?highlight=${project.id}`}
          style={`--accent: ${getCategoryColor(index)}`}
        >
          <div class="card-image">
            <img src={project.images[0]} alt={project.title} loading="lazy" />
            <div class="card-overlay">
              <span class="overlay-label">
                <i class="pi pi-external-link"></i>
                Ver proyecto
              </span>
            </div>
            <div class="card-status">
              <span class="status-dot"></span>
              En desarrollo
            </div>
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span class="card-date">
                <i class="pi pi-calendar"></i>
                {project.date}
              </span>
              <span class="card-client">{project.client}</span>
            </div>
            <h3 class="card-title">{project.title}</h3>
            <p class="card-desc">{project.description}</p>
            <div class="card-techs">
              {project.technologies.slice(0, 4).map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
              {project.technologies.length > 4 && (
                <span class="tech-more">+{project.technologies.length - 4}</span>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <div class="bottom-cta">
    <a class="btn-all" href="/projects/">
      <i class="pi pi-folder-open"></i>
      <span>Ver todos los proyectos</span>
      <i class="pi pi-arrow-right"></i>
    </a>
  </div>
</section>
